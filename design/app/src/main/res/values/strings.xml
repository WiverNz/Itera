    <!-- Techniques -->
    <string name="t_two_name">2-minute rule</string>
    <string name="t_two_short">Clear small tasks before they accumulate.</string>
    <string name="t_two_why">If something takes less than two minutes, do it now. Small tasks are cheap to finish and expensive to keep remembering.</string>
    <string name="t_two_task">Look at your current to-dos. Find two tasks that take under two minutes — and finish them now.</string>

    <string name="t_pomodoro_name">Pomodoro</string>
    <string name="t_pomodoro_short">Work in 25-minute sprints with real breaks.</string>
    <string name="t_pomodoro_why">A timer turns “work on it” into a small unit you can finish. Short breaks keep attention fresh across the day.</string>
    <string name="t_pomodoro_task">Pick one task. Work on it for 25 minutes without switching, then take a real 5-minute break.</string>

    <string name="t_eisenhower_name">Eisenhower matrix</string>
    <string name="t_eisenhower_short">Sort tasks by importance, not by noise.</string>
    <string name="t_eisenhower_why">Urgent things shout; important things rarely do. Sorting both ways shows what deserves your best hours.</string>
    <string name="t_eisenhower_task">Put everything on your plate into four squares. Then pick one task from “Do now”.</string>

    <string name="t_five_name">5-second rule</string>
    <string name="t_five_short">Count 5-4-3-2-1 and move before doubt starts.</string>
    <string name="t_five_why">Hesitation grows with every second. Counting down gives your brain a clear start signal before excuses arrive.</string>
    <string name="t_five_task">Pick one thing you’ve been putting off. Count 5-4-3-2-1 out loud and take the first physical step at 1.</string>

    <string name="t_stack_name">Habit stacking</string>
    <string name="t_stack_short">Attach a new habit to one you already have.</string>
    <string name="t_stack_why">An existing habit is a reliable trigger. Tying a tiny new action to it removes the need to remember.</string>
    <string name="t_stack_task">Complete one sentence: “After I [habit I already have], I will [tiny new habit].” Do it today.</string>

    <string name="t_feynman_name">Feynman technique</string>
    <string name="t_feynman_short">Explain it simply to find what you don’t know.</string>
    <string name="t_feynman_why">Explaining in plain words shows exactly where your understanding has gaps.</string>
    <string name="t_feynman_task">Pick a topic you’re learning and explain it in simple words, as if to a curious 12-year-old. No notes.</string>

    <string name="t_twolist_name">Two-list strategy</string>
    <string name="t_twolist_short">Decide what you’re deliberately not doing now.</string>
    <string name="t_twolist_why">Choosing what you won’t do protects your focus for the few goals that matter most.</string>
    <string name="t_twolist_task">Write down your goals. Keep the top three. Move the rest to a “Not now” list and leave it alone this week.</string>

    <string name="t_deep_name">Deep Work</string>
    <string name="t_deep_short">Long, protected blocks for hard problems.</string>
    <string name="t_deep_why">Hard problems need long, unbroken attention. Protecting it on purpose is a skill you can train.</string>
    <string name="t_deep_task">Block 50 minutes for one demanding task. Close everything else and silence your phone.</string>

    <string name="t_pareto_name">80/20 principle</string>
    <string name="t_pareto_short">Find the few actions that drive most of the result.</string>
    <string name="t_pareto_why">A small share of actions usually drives most of the result. Finding them first saves hours.</string>
    <string name="t_pareto_task">Take your most important task. List its steps and mark the one that moves it most. Start there.</string>

    <string name="t_spaced_name">Spaced repetition</string>
    <string name="t_spaced_short">Return to what you learned at growing intervals.</string>
    <string name="t_spaced_why">Memory fades fast, but each well-timed recall makes it last longer.</string>
    <string name="t_spaced_task">Pick something you learned this week. Recall it from memory now, then check what you missed.</string>

    <string name="t_diet_name">Information diet</string>
    <string name="t_diet_short">Choose what you consume on purpose.</string>
    <string name="t_diet_why">What you consume shapes what you think about. Choosing inputs on purpose frees attention.</string>
    <string name="t_diet_task">Pick one feed or app to skip today. Before opening anything, ask: do I need this right now?</string>

    <string name="t_premortem_name">Premortem</string>
    <string name="t_premortem_short">Imagine the failure first, then prevent it.</string>
    <string name="t_premortem_why">Imagining failure in advance makes risks concrete while there’s still time to act.</string>
    <string name="t_premortem_task">Imagine your project failed completely six months from now. Write down why, then pick one step to reduce the biggest risk today.</string>

    <string name="t_onepct_name" formatted="false">1% improvement</string>
    <string name="t_onepct_short">Improve one small thing, every day.</string>
    <string name="t_onepct_why">Tiny improvements are easy to repeat, and they add up over weeks.</string>
