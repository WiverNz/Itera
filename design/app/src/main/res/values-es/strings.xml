    <string name="t_two_name">Regla de los 2 minutos</string>
    <string name="t_two_short">Resuelve las tareas pequeñas antes de que se acumulen.</string>
    <string name="t_two_why">Si algo lleva menos de dos minutos, hazlo ya. Las tareas pequeñas cuestan poco de terminar y mucho de recordar.</string>
    <string name="t_two_task">Mira tus pendientes. Encuentra dos tareas de menos de dos minutos y termínalas ahora.</string>

    <string name="t_pomodoro_name">Pomodoro</string>
    <string name="t_pomodoro_short">Trabaja en sprints de 25 minutos con descansos de verdad.</string>
    <string name="t_pomodoro_why">Un temporizador convierte «trabajar en ello» en una unidad pequeña que puedes terminar. Las pausas cortas mantienen la atención fresca.</string>
    <string name="t_pomodoro_task">Elige una tarea. Trabaja en ella 25 minutos sin cambiar de tarea y luego tómate un descanso real de 5 minutos.</string>

    <string name="t_eisenhower_name">Matriz de Eisenhower</string>
    <string name="t_eisenhower_short">Ordena por importancia, no por ruido.</string>
    <string name="t_eisenhower_why">Lo urgente grita; lo importante casi nunca. Ordenar con ambos criterios muestra qué merece tus mejores horas.</string>
    <string name="t_eisenhower_task">Reparte todo lo que tienes entre manos en cuatro cuadrantes. Luego elige una tarea de «Hacer ya».</string>

    <string name="t_five_name">Regla de los 5 segundos</string>
    <string name="t_five_short">Cuenta 5-4-3-2-1 y muévete antes de dudar.</string>
    <string name="t_five_why">La duda crece con cada segundo. La cuenta atrás da a tu cerebro una señal de salida antes de que lleguen las excusas.</string>
    <string name="t_five_task">Elige algo que estés posponiendo. Cuenta en voz alta 5-4-3-2-1 y en el 1 da el primer paso físico.</string>

    <string name="t_stack_name">Encadenar hábitos</string>
    <string name="t_stack_short">Engancha un hábito nuevo a uno que ya tienes.</string>
    <string name="t_stack_why">Un hábito existente es un disparador fiable. Si le enganchas una acción nueva diminuta, no tendrás que acordarte.</string>
    <string name="t_stack_task">Completa una frase: «Después de [hábito que ya tengo], voy a [hábito nuevo diminuto]». Hazlo hoy.</string>

    <string name="t_feynman_name">Técnica Feynman</string>
    <string name="t_feynman_short">Explícalo con sencillez para descubrir lo que no sabes.</string>
    <string name="t_feynman_why">Explicar con palabras sencillas muestra exactamente dónde hay lagunas en lo que entiendes.</string>
    <string name="t_feynman_task">Elige un tema que estés aprendiendo y explícalo con palabras sencillas, como a un niño curioso de 12 años. Sin apuntes.</string>

    <string name="t_twolist_name">Estrategia de las dos listas</string>
    <string name="t_twolist_short">Decide qué no vas a hacer ahora, a propósito.</string>
    <string name="t_twolist_why">Elegir lo que no harás protege tu atención para las pocas metas que más importan.</string>
    <string name="t_twolist_task">Escribe tus metas. Quédate con las tres principales. Pasa el resto a una lista de «Ahora no» y no la toques esta semana.</string>

    <string name="t_deep_name">Trabajo profundo</string>
    <string name="t_deep_short">Bloques largos y protegidos para problemas difíciles.</string>
    <string name="t_deep_why">Los problemas difíciles necesitan atención larga y sin interrupciones. Protegerla a propósito es una habilidad entrenable.</string>
    <string name="t_deep_task">Reserva 50 minutos para una tarea exigente. Cierra todo lo demás y silencia el móvil.</string>

    <string name="t_pareto_name">Principio 80/20</string>
    <string name="t_pareto_short">Encuentra las pocas acciones que dan la mayor parte del resultado.</string>
    <string name="t_pareto_why">Una pequeña parte de las acciones suele producir la mayor parte del resultado. Encontrarlas primero ahorra horas.</string>
    <string name="t_pareto_task">Toma tu tarea más importante. Enumera sus pasos y marca el que más la hace avanzar. Empieza por ahí.</string>

    <string name="t_spaced_name">Repetición espaciada</string>
    <string name="t_spaced_short">Vuelve a lo aprendido en intervalos cada vez mayores.</string>
    <string name="t_spaced_why">La memoria se desvanece rápido, pero cada recuerdo en el momento justo la hace durar más.</string>
    <string name="t_spaced_task">Elige algo que hayas aprendido esta semana. Recuérdalo ahora de memoria y luego comprueba qué se te escapó.</string>

    <string name="t_diet_name">Dieta informativa</string>
    <string name="t_diet_short">Elige a propósito lo que consumes.</string>
    <string name="t_diet_why">Lo que consumes moldea aquello en lo que piensas. Elegir tus fuentes a propósito libera atención.</string>
    <string name="t_diet_task">Elige un feed o una app que hoy vas a saltarte. Antes de abrir nada, pregúntate: ¿lo necesito ahora mismo?</string>

    <string name="t_premortem_name">Premortem</string>
    <string name="t_premortem_short">Imagina primero el fracaso y luego evítalo.</string>
    <string name="t_premortem_why">Imaginar el fracaso por adelantado vuelve concretos los riesgos mientras aún hay tiempo para actuar.</string>
    <string name="t_premortem_task">Imagina que dentro de seis meses tu proyecto ha fracasado por completo. Anota por qué y elige un paso para reducir hoy el mayor riesgo.</string>

    <string name="t_onepct_name" formatted="false">Mejora del 1 %</string>
    <string name="t_onepct_short">Mejora una cosa pequeña cada día.</string>
    <string name="t_onepct_why">Las mejoras diminutas son fáciles de repetir y se suman con las semanas.</string>
    <string name="t_onepct_task" formatted="false">Elige una habilidad o un hábito. Hazlo hoy un 1 % mejor con un cambio pequeño y concreto.</string>

    <string name="t_reflect_name">Reflexión diaria</string>
    <string name="t_reflect_short">Tres preguntas breves para cerrar el día.</string>
    <string name="t_reflect_why">Una mirada breve hacia atrás convierte la experiencia del día en una lección para mañana.</string>
    <string name="t_reflect_task">Responde a tres preguntas: qué salió bien, qué no y qué cambiarás mañana.</string>
